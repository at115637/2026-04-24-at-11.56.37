---
import Base from '../layouts/Base.astro';
---
<Base title="Publications">
  <div class="sidebar">
    <ul>
      <li><a data-astro-reload href="/search" class="nav-link">SEARCH</a></li>
      <li><a data-astro-reload href="/articles" class="nav-link">ARTICLES</a></li>
      <li><a data-astro-reload href="/newsletter" class="nav-link">NEWSLETTER</a></li>
      <li><a data-astro-reload href="/publications" class="nav-link active">PUBLICATIONS</a></li>
      <li><a data-astro-reload href="/info" class="nav-link">INFO</a></li>
    </ul>
  </div>
  <div class="mobile-header">
    <nav class="mobile-nav">
      <a data-astro-reload href="/search">SEARCH</a>
      <a data-astro-reload href="/articles">ARTICLES</a>
      <a data-astro-reload href="/newsletter">NEWS.</a>
      <a data-astro-reload href="/publications" class="active">PUBL.</a>
      <a data-astro-reload href="/info">INFO</a>
    </nav>
  </div>
  <div class="page-content">
    <div class="loader">
      <div class="spinner"></div>
      <span class="loader-text">PRINT RELEASE 2027 LOADING</span>
    </div>
  </div>
</Base>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  .sidebar { position: fixed; top: 22px; left: 0; width: 140px; padding: 0 24px; z-index: 100; }
  .sidebar ul { list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .nav-link { font-family: 'DM Mono', monospace; font-size: 10px; color: #aaa; text-decoration: none; letter-spacing: 0.06em; display: block; transition: color 0.15s; }
  .nav-link:hover { color: #111; }
  .nav-link.active { color: #111; }
  .mobile-header { display: none; }

  .page-content {
    padding-left: 140px;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loader {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  .spinner {
    width: 48px;
    height: 48px;
    border: 1px solid #e0e0e0;
    border-top-color: #aaa;
    border-radius: 50%;
    animation: spin 1.2s linear infinite;
  }

  .loader-text {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    font-weight: 300;
    color: #bbb;
    letter-spacing: 0.06em;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (min-width: 601px) {
    .spinner {
      width: 80px;
      height: 80px;
    }
    .loader-text {
      font-size: 9px;
    }
  }

  @media (max-width: 600px) {
    .sidebar { display: none; }
    .mobile-header {
      display: block;
      width: 100%;
      padding: 14px 20px 0;
    }
    .mobile-nav {
      display: flex;
      justify-content: space-between;
      width: 100%;
      padding: 38px 4px 0;
    }
    .mobile-nav a { font-family: 'DM Mono', monospace; font-size: 9px; color: #aaa; letter-spacing: 0; text-decoration: none; transition: color 0.15s; }
    .mobile-nav a:hover { color: #111; }
    .mobile-nav a.active { color: #111; }
    .page-content { padding-left: 0; }
  }
</style>