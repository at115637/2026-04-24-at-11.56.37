---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();

// Format date — shown directly below the title, greyed out
const dateObj = new Date(article.data.date);
const formattedDate = dateObj.toLocaleDateString('de-DE', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
});
---
<Base title={article.data.title}>
  <div class="sidebar">
    <ul>
      <li><a data-astro-reload href="/search" class="nav-link">SEARCH</a></li>
      <li><a data-astro-reload href="/articles" class="nav-link">ARTICLES</a></li>
      <li><a data-astro-reload href="/newsletter" class="nav-link">NEWSLETTER</a></li>
      <li><a data-astro-reload href="/publications" class="nav-link">PUBLICATIONS</a></li>
      <li><a data-astro-reload href="/info" class="nav-link">INFO</a></li>
    </ul>
  </div>
  <div class="mobile-header">
    <nav class="mobile-nav">
      <a data-astro-reload href="/search">SEARCH</a>
      <a data-astro-reload href="/articles">ARTICLES</a>
      <a data-astro-reload href="/newsletter">NEWS.</a>
      <a data-astro-reload href="/publications" >PUBL.</a>
      <a data-astro-reload href="/info">INFO</a>
    </nav>
  </div>

  <div id="top" class="page-content">
    <article class="article-content">

      {/* Titelbild — ersetzt das bisherige coverImage */}
      {/* Header-Text statt Bild (z.B. Artikel 04) */}
      {article.data.headerText && (
        <div class="header-text">
          {article.data.headerText.split('\n').map((line: string) =>
            line === '' ? <br /> : <span>{line}<br /></span>
          )}
        </div>
      )}

      {/* Titelbild — nur wenn vorhanden und kein headerText */}
      {!article.data.headerText && article.data.titleImage && (
        <div class="cover-wrap">
          <div class="cover">
            <img src={article.data.titleImage} alt={article.data.title} loading="lazy" decoding="async" />
          </div>
          {article.data.titleImageCredit && (
            <p class="image-credit">{article.data.titleImageCredit}</p>
          )}
        </div>
      )}
      {!article.data.headerText && !article.data.titleImage && article.data.coverImage && (
        <div class="cover-wrap">
          <div class="cover">
            <img src={article.data.coverImage} alt={article.data.title} loading="lazy" decoding="async" />
          </div>
          {article.data.imageCredit && (
            <p class="image-credit">{article.data.imageCredit}</p>
          )}
        </div>
      )}

      {/* 1. Überschrift fett, klar als Titel lesbar */}
      <h1 class="article-title">{article.data.title}</h1>

      {/* Untertitel falls vorhanden */}
      {article.data.subtitle && (
        <p class="article-subtitle">{article.data.subtitle}</p>
      )}

      {/* 4. Datum direkt unter dem Titel, ausgegraut */}
      <p class="article-date">{formattedDate}</p>

      {/* 7. Autor unter dem Datum, "written by" Prefix */}
      {article.data.author && (
        <p class="article-author">by {article.data.author}</p>
      )}

      <div class={`body body-${article.slug}`}>
        <Content />
      </div>

      {/* 6. Back to top — am Ende langer Artikel */}
      <a href="#top" class="back-to-top" id="back-to-top-link" aria-label="Back to top">↑</a>
    </article>
  </div>
</Base>

<script>
  // 3. Alle externen Links im Artikel-Body in neuem Tab öffnen
  document.querySelectorAll('.body a[href^="http"]').forEach((a) => {
    a.setAttribute('target', '_blank');
    a.setAttribute('rel', 'noopener noreferrer');
  });

  // 6. Back-to-top: sanftes Scrollen nach oben
  const backLink = document.getElementById('back-to-top-link');
  if (backLink) {
    backLink.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&display=swap');

  * { box-sizing: border-box; margin: 0; padding: 0; }

  /* Sidebar / Navigation */
  .sidebar { position: fixed; top: 22px; left: 0; width: 140px; padding: 0 24px; z-index: 100; }
  .sidebar ul { list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .nav-link {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    color: #aaa;
    text-decoration: none;
    letter-spacing: 0.06em;
    display: block;
    transition: color 0.15s;
  }
  /* 2. Menü-Reiter werden beim Hover dunkel */
  .nav-link:hover { color: #111; }
  .nav-link.disabled { color: #ddd; pointer-events: none; }
  .mobile-header { display: none; }

  .article-content { max-width: 560px; margin: 0 auto; padding: 20px 40px 100px; }

  .cover-wrap { margin-bottom: 8px; }
  .cover { width: 100%; overflow: hidden; }
  .cover img { width: 100%; height: auto; display: block; }

  .header-text {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    font-weight: 400;
    color: #999;
    line-height: 1.6;
    margin-bottom: 8px;
    white-space: pre-line;
  }

  .image-credit {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    font-weight: 300;
    color: #bbb;
    letter-spacing: 0.03em;
    text-align: right;
    margin-top: 5px;
  }

  /* 1. Überschrift: fett, kleiner */
  .article-title {
    font-family: 'DM Mono', monospace !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    color: #999 !important;
    line-height: 1.2 !important;
    margin-top: 14px !important;
    margin-bottom: 2px !important;
    letter-spacing: -0.005em !important;
  }
  .article-subtitle {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    font-weight: 300;
    color: #bbb;
    margin-bottom: 14px;
    line-height: 1.4;
  }

  /* 4. Datum direkt unter dem Titel — kleiner, hellgrau */
  .article-date {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    font-weight: 300;
    color: #aaa;
    letter-spacing: 0.04em;
    margin-bottom: 2px;
    line-height: 1.4;
  }

  /* 7. Autor unter dem Datum, "written by" — kleiner, hellgrau */
  .article-author {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    font-weight: 300;
    color: #aaa;
    letter-spacing: 0.04em;
    margin-bottom: 18px;
    line-height: 1.4;
  }

  /* Body — alles im einheitlichen hellgrau */
  .body {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    font-weight: 300;
    color: #999;
    line-height: 1.8;
  }

  /* Erster Absatz — weniger Abstand zum Datum/Autor drüber */
  .body p:first-child {
    font-family: 'DM Mono', monospace !important;
    font-size: 11px !important;
    font-weight: 300 !important;
    color: #999 !important;
    margin-top: 0 !important;
    margin-bottom: 12px !important;
    line-height: 1.6 !important;
  }

  /* Folgende Absätze — kleinere Abstände, gleiches Hellgrau */
  .body p {
    margin-bottom: 12px;
    color: #999;
  }
  .body img {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 48px;
    margin-bottom: 48px;
  }
  /* Artikel 04: erstes Body-Bild (Panorama) breiter */
  .body-artikel-04 p:first-child img {
    width: calc(100% + 200px);
    margin-left: -100px;
  }
  /* Figure layouts für Artikel 05 */
  .body figure {
    margin: 48px 0;
    padding: 0;
  }
  .body figure img {
    margin: 0;
    width: 100%;


    display: block;
  }
  .body figure figcaption {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    font-weight: 300;
    color: #bbb;
    text-align: right;
    margin-top: 5px;
  }
  .body .img-full img {
    width: 100%;
  }
  .body .img-small-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .body .img-small-right img {
    width: 50%;
  }
  .body .img-small-right figcaption {
    width: 50%;
  }
  .body audio, .body video { width: 100%; margin: 20px 0; display: block; }
  .body audio { filter: grayscale(1); }

  /* 6. Liste: mittig zentriert, ohne Bullet-Points */
  .body ol, .body ul {
    list-style: none !important;
    display: block !important;
    margin: 32px 0 14px !important;
    padding: 0 !important;
    text-align: center !important;
  }
  .body ol li, .body ul li {
    font-family: 'DM Mono', monospace !important;
    font-size: 11px !important;
    font-weight: 300 !important;
    font-style: normal !important;
    color: #999 !important;
    text-align: center !important;
    line-height: 1.8 !important;
    list-style: none !important;
    padding-left: 0 !important;
    margin-bottom: 1.8em !important;
  }
  .body ol li:last-child, .body ul li:last-child {
    margin-bottom: 0 !important;
  }
  .body ol li::marker, .body ul li::marker {
    content: '' !important;
    display: none !important;
  }

  /* Song-Links: kein Link-Look, hover heller */
  .body a {
    color: inherit !important;
    text-decoration: none !important;
    transition: color 0.15s !important;
  }
  .body ol li a, .body ul li a {
    color: #999 !important;
    text-decoration: none !important;
    transition: color 0.15s !important;
  }
  .body a:hover,
  .body ol li a:hover,
  .body ul li a:hover {
    color: #ccc !important;
  }

  /* 8. Back to top — größerer Pfeil */
  .back-to-top {
    display: inline-block;
    margin-top: 60px;
    font-family: 'DM Mono', monospace;
    font-size: 16px;
    font-weight: 300;
    color: #bbb;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.15s;
    line-height: 1;
  }
  .back-to-top:hover { color: #111; }

  @media (max-width: 600px) {
    .sidebar { display: none; }
    .mobile-header {
      display: block;
      width: 100%;
      padding: 14px 20px 0;
    }
    
    .mobile-nav {
      display: flex;
      justify-content: space-between;
      width: 100%;
      padding: 38px 4px 0;
    }
    .mobile-nav a {
      font-family: 'DM Mono', monospace;
      font-size: 9px;
      color: #aaa;
      letter-spacing: 0;
      text-decoration: none;
      transition: color 0.15s;
    }
    .mobile-nav a:hover { color: #111; }
    .mobile-nav a.disabled { color: #e0e0e0; pointer-events: none; }

    .article-content { padding: 40px 20px 80px; }

    .body img {
      margin-top: 36px;
      margin-bottom: 36px;
    }
    .body-artikel-04 p:first-child img {
      width: calc(100% + 40px);
      margin-left: -20px;
    }
    .body .img-small-right img { width: 70%; }
    .body .img-small-right figcaption { width: 70%; }

    .article-title {
      font-size: 11px !important;
      margin-top: 12px !important;
    }
    .article-date {
      margin-bottom: 2px;
    }
    .article-author {
      margin-bottom: 16px;
    }
    .back-to-top {
      font-size: 18px;
    }
  }
</style>
