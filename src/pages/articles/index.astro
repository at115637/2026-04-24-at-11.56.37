---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---
<Base title="Contributions">
  <div class="sidebar">
    <ul>
      <li><a data-astro-reload href="/search" class="nav-link">SEARCH</a></li>
      <li><a data-astro-reload href="/articles" class="nav-link active">CONTRIBUTIONS</a></li>
      <li><a data-astro-reload href="/newsletter" class="nav-link">NEWSLETTER</a></li>
      <li><a data-astro-reload href="/publications" class="nav-link">PUBLICATIONS</a></li>
      <li><a data-astro-reload href="/info" class="nav-link">INFO</a></li>
    </ul>
  </div>
  <div class="mobile-header">
    <nav class="mobile-nav">
      <a data-astro-reload href="/search">SEARCH</a>
      <a data-astro-reload href="/articles" class="active">CONTRIB.</a>
      <a data-astro-reload href="/newsletter">NEWS.</a>
      <a data-astro-reload href="/publications">PUBL.</a>
      <a data-astro-reload href="/info">INFO</a>
    </nav>
  </div>
  <div class="page-content">
    <section class="list">
      {articles.map((article) => (
        <a data-astro-reload href={`/articles/${article.slug}`} class="article-row">
          <span class="article-title">{article.data.title}</span>
          <span class="article-meta">{new Date(article.data.date).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' })} · {article.data.author}</span>
        </a>
      ))}
    </section>
  </div>
</Base>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  .sidebar { position: fixed; top: 22px; left: 0; width: 140px; padding: 0 24px; z-index: 100; }
  .sidebar ul { list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .nav-link { font-family: 'DM Mono', monospace; font-size: 10px; color: #aaa; text-decoration: none; letter-spacing: 0.06em; display: block; transition: color 0.15s; }
  .nav-link:hover { color: #111; font-style: italic; }
  .nav-link.active { color: #111; }
  .mobile-header { display: none; }
  .page-content { padding-left: 140px; min-height: 100vh; display: flex; justify-content: center; }
  .list { padding: 40px 40px 80px; display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 560px; }
  .article-row { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 14px 0; width: 100%; text-decoration: none; transition: opacity 0.15s; }
  .article-row:hover { opacity: 0.4; }
  .article-row:hover .article-title { font-style: italic; }
  .article-row:hover .article-meta { font-style: italic; }
  .article-title { font-family: 'DM Mono', monospace; font-size: 11px; font-weight: 300; color: #888; letter-spacing: 0.02em; line-height: 1.4; }
  .article-meta { font-family: 'DM Mono', monospace; font-size: 9px; color: #bbb; margin-top: 3px; letter-spacing: 0.04em; }
  @media (max-width: 600px) {
    .sidebar { display: none; }
    .mobile-header { display: block; width: 100%; padding: 14px 20px 0; }
    .mobile-nav { display: flex; justify-content: space-between; width: 100%; padding: 38px 4px 0; }
    .mobile-nav a { font-family: 'DM Mono', monospace; font-size: 9px; color: #aaa; letter-spacing: 0; text-decoration: none; transition: color 0.15s; }
    .mobile-nav a:hover { color: #111; font-style: italic; }
    .mobile-nav a.active { color: #111; }
    .page-content { padding-left: 0; }
    .list { padding: 20px 20px 60px; }
  }
</style>
