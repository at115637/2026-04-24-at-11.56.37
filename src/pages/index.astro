---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const latest = articles[0];
---
<Base>
  <div class="sidebar">
    <ul>
      <li><a data-astro-reload href="/search" class="nav-link">SEARCH</a></li>
      <li><a data-astro-reload href="/articles" class="nav-link">ARTICLES</a></li>
      <li><a data-astro-reload href="/newsletter" class="nav-link">NEWSLETTER</a></li>
      <li><a data-astro-reload href="/publications" class="nav-link">PUBLICATIONS</a></li>
      <li><a data-astro-reload href="/info" class="nav-link">INFO</a></li>
    </ul>
  </div>

  <div class="mobile-header">
    <nav class="mobile-nav">
      <a data-astro-reload href="/search">SEARCH</a>
      <a data-astro-reload href="/articles">ARTICLES</a>
      <a data-astro-reload href="/newsletter">NEWS.</a>
      <a data-astro-reload href="/publications" >PUBL.</a>
      <a data-astro-reload href="/info">INFO</a>
    </nav>
  </div>

  <div class="page-content">
    <section class="hero">
      {latest && (
        <a data-astro-reload href={`/articles/${latest.slug}`} class="hero-link">
          {(latest.data.titleImage || latest.data.coverImage) ? (
            <div class="hero-img">
              <img src={latest.data.titleImage ?? latest.data.coverImage} alt={latest.data.title} loading="lazy" />
            </div>
          ) : latest.data.headerText ? (
            <div class="hero-text">
              {latest.data.headerText.split('\n').map((line: string) =>
                line === '' ? <br /> : <span>{line}<br /></span>
              )}
            </div>
          ) : null}
        </a>
      )}
    </section>
  </div>
</Base>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  .sidebar {
    position: fixed;
    top: 22px; left: 0;
    width: 140px;
    padding: 0 24px;
    z-index: 100;
  }
  .sidebar ul { list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .nav-link { font-family: 'DM Mono', monospace; font-size: 10px; color: #aaa; text-decoration: none; letter-spacing: 0.06em; display: block; }
  .nav-link:hover { color: #333; }
  .nav-link.disabled { color: #ddd; pointer-events: none; }

  .mobile-header { display: none; }

  .page-content {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero { width: 100%; display: flex; justify-content: center; padding: 80px 40px 60px; }
  .hero-link { display: block; text-decoration: none; width: 100%; max-width: 700px; }
  .hero-img { width: 100%; aspect-ratio: 4/3; overflow: hidden; }
  .hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity 0.2s; }
  .hero-text {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    font-weight: 400;
    color: #999;
    line-height: 1.6;
    white-space: pre-line;
    transition: color 0.2s;
  }
  .hero-link:hover .hero-text { color: #111; }
  .hero-link:hover img { opacity: 0.8; }

  @media (max-width: 600px) {
    .sidebar { display: none; }
    /* Mobile-Header ist KEIN fixer Block mehr — nur das Logo ist sticky */
    .mobile-header {
      display: block;
      width: 100%;
      padding: 14px 20px 0;
    }
    /* Logo: sticky am Bildschirmrand, transparenter Hintergrund */
    
    /* Menü-Reiter: scrollen mit, breit verteilt */
    .mobile-nav {
      display: flex;
      justify-content: space-between;
      width: 100%;
      padding: 38px 4px 0;
    }
    .mobile-nav a {
      font-family: 'DM Mono', monospace;
      font-size: 9px;
      color: #aaa;
      letter-spacing: 0;
      text-decoration: none;
      transition: color 0.15s;
    }
    .mobile-nav a:hover { color: #111; }
    .mobile-nav a.disabled { color: #e0e0e0; pointer-events: none; }

    /* Inhalt vertikal mittig — Bild zentriert auf dem Screen */
    .page-content {
      min-height: calc(100vh - 80px);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .hero { padding: 0 20px; }
  }
</style>
